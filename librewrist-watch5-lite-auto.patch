+/** Selects the catalogue-requested APK variant from an exact APKMirror release page. */
+private fun autoPickMirrorVariant(view: WebView, input: InputApp) {
+    val wantedVersion = jsQuote(input.versionName.lowercase())
+    val wantedAbis = input.abis.joinToString(prefix = "[", postfix = "]") { jsQuote(it.lowercase()) }
+    val script = """
+        (() => {
+          const version = $wantedVersion;
+          const abis = $wantedAbis;
+          const candidates = [...document.querySelectorAll('a[href]')].filter(a => {
+            const h = (a.href || '').toLowerCase();
+            return h.includes('-android-apk-download/') && h.includes(version.replaceAll('.', '-'));
+          });
+          let best = null, bestScore = -1;
+          for (const a of candidates) {
+            let n = a, text = '';
+            for (let i = 0; i < 6 && n; i++, n = n.parentElement) text += ' ' + (n.innerText || '');
+            text = text.toLowerCase();
+            let score = text.includes(' apk') ? 3 : 0;
+            if (text.includes('nodpi')) score += 4;
+            for (const abi of abis) if (text.includes(abi)) score += 2;
+            if (score > bestScore) { best = a; bestScore = score; }
+          }
+          if (best) { best.click(); return 'clicked'; }
+          return 'none';
+        })();
+    """.trimIndent()
+    view.evaluateJavascript(script, null)
+}
+
+/** Waits out APKMirror's countdown, then follows its per-request /download/?key= link. */
+private fun autoClickMirrorDownload(view: WebView) {
+    val script = """
+        (() => {
+          const links = [...document.querySelectorAll('a[href]')];
+          const a = links.find(x => (x.href || '').includes('/download/?key=')) ||
+                    links.find(x => /download\s+apk/i.test((x.innerText || '').trim()));
+          if (a) { a.click(); return 'clicked'; }
+          return 'none';
+        })();
+    """.trimIndent()
+    view.evaluateJavascript(script, null)
+}
+
+/** On APKMirror's last hand-off page, clicks the real file link if the page did not auto-start it. */
+private fun autoClickMirrorFinalFile(view: WebView) {
+    val script = """
+        (() => {
+          const links = [...document.querySelectorAll('a[href]')];
+          const a = links.find(x => /\.apk([?#].*)?$/i.test(x.href || '')) ||
+                    links.find(x => /click\s+here|download\s+apk/i.test((x.innerText || '').trim()));
+          if (a) { a.click(); return 'clicked'; }
+          return 'none';
+        })();
+    """.trimIndent()
+    view.evaluateJavascript(script, null)
+}
+
+/** JSON/JavaScript string literal without exposing a JavaScript bridge to the page. */
+private fun jsQuote(value: String): String = buildString {
+    append('"')
+    value.forEach { c ->
+        when (c) {
+            '\\' -> append("\\\\")
+            '"' -> append("\\\"")
+            '\n' -> append("\\n")
+            '\r' -> append("\\r")
+            '\t' -> append("\\t")
+            else -> if (c.code < 0x20) append("\\u%04x".format(c.code)) else append(c)
+        }
+    }
+    append('"')
+}
